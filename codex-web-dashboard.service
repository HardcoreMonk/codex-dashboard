[Unit]
Description=Codex Web Dashboard
After=network.target

[Service]
Type=simple
# Codex 전용 인스턴스: 서비스/DB/백업 루트를 Codex 기준으로 고정한다.
User=hardcoremonk
WorkingDirectory=/data/projects/codex-zone/codex-dashboard
ExecStart=/data/projects/codex-zone/codex-dashboard/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8617 --loop asyncio --http h11 --log-level info
Restart=always
RestartSec=5
EnvironmentFile=-/data/projects/codex-zone/codex-dashboard/.env
Environment=PORT=8617
Environment=CODEX_ZONE_ROOT=/data/projects/codex-zone
Environment=CODEX_GOVERNANCE_REPO_DIR=/data/projects/codex-zone/codex-project-mgmt
Environment=CODEX_PROJECTS_REGISTRY=/data/projects/codex-zone/projects.yaml
Environment=CODEX_ZONE_WIKI_DIR=/data/projects/codex-zone/wiki
Environment=CODEX_ZONE_RAW_DIR=/data/projects/codex-zone/raw
Environment=DASHBOARD_DB_PATH=/home/hardcoremonk/.codex/dashboard.db
Environment=DASHBOARD_BACKUP_DIR=/home/hardcoremonk/.codex/dashboard-backups
Environment=PYTHONDONTWRITEBYTECODE=1
# Optional: set DASHBOARD_PASSWORD=yourpassword to require cookie-session login

# Resource limits — tuned for a 500 MB-ish DB and 8 parallel scan workers.
MemoryMax=512M
MemoryHigh=384M
CPUQuota=150%
TasksMax=256
LimitNOFILE=8192

# Hardening — read-only filesystem except for Codex state and managed zone writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hardcoremonk/.codex /data/projects/codex-zone
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-web-dashboard

[Install]
WantedBy=multi-user.target
